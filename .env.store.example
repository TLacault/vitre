# Copy to .env.store (git-ignored) and fill in. `pnpm release` reads it.

# Firefox: https://addons.mozilla.org/developers/addon/api/key/ → Generate new credentials
WEB_EXT_API_KEY=user:00000000:000
WEB_EXT_API_SECRET=

# Chrome: the item's ID (dashboard URL), your publisher ID (dashboard → Account),
# and an OAuth client + refresh token for the Chrome Web Store API (see README → Release)
EXTENSION_ID=
PUBLISHER_ID=
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=
